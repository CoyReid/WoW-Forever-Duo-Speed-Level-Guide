{
  "scopeName": "rxp.guide.injection",
  "injectionSelector": "L:source.lua -comment -string",
  "patterns": [
    {
      "include": "#guide"
    }
  ],
  "repository": {
    "guide": {
      "begin": "\\b(RegisterGuide)\\s*(\\()\\s*(?:\"[^\"]*\"\\s*,\\s*)?(\\[(=*)\\[)",
      "beginCaptures": {
        "1": {
          "name": "support.function.lua"
        },
        "3": {
          "name": "punctuation.definition.string.begin.lua"
        }
      },
      "end": "(\\]\\4\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.lua"
        }
      },
      "contentName": "meta.embedded.block.rxp",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#step"
        },
        {
          "include": "#tag"
        },
        {
          "include": "#command"
        },
        {
          "include": "#filter"
        },
        {
          "include": "#arrow"
        },
        {
          "include": "#text"
        }
      ]
    },
    "comment": {
      "match": "--.*$",
      "name": "comment.line.double-dash.rxp"
    },
    "step": {
      "match": "^\\s*(s?step)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.step.rxp"
        }
      }
    },
    "tag": {
      "begin": "^\\s*(#[A-Za-z_]+)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.directive.rxp"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#filter"
        },
        {
          "match": "[^\\s<-][^<]*?(?=\\s*(?:<<|--|$))",
          "name": "entity.name.label.rxp"
        }
      ]
    },
    "command": {
      "begin": "^\\s*(\\.[A-Za-z_]+)\\b",
      "beginCaptures": {
        "1": {
          "name": "support.function.command.rxp"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": ">>",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.arrow.rxp"
            }
          },
          "end": "(?=$)",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#text"
            }
          ]
        },
        {
          "include": "#filter"
        },
        {
          "include": "#text"
        },
        {
          "include": "#number"
        }
      ]
    },
    "filter": {
      "match": "(<<)\\s*(.*?)(?=\\s*(?:--|$))",
      "captures": {
        "1": {
          "name": "keyword.operator.filter.rxp"
        },
        "2": {
          "name": "entity.name.type.filter.rxp"
        }
      }
    },
    "arrow": {
      "match": ">>",
      "name": "keyword.operator.arrow.rxp"
    },
    "number": {
      "match": "(?<![A-Za-z_])-?\\d+(?:\\.\\d+)?",
      "name": "constant.numeric.rxp"
    },
    "text": {
      "patterns": [
        {
          "include": "#color-friendly"
        },
        {
          "include": "#color-enemy"
        },
        {
          "include": "#color-warn"
        },
        {
          "include": "#color-loot"
        },
        {
          "include": "#color-buy"
        },
        {
          "include": "#color-pick"
        },
        {
          "include": "#color-other-rxp"
        },
        {
          "include": "#color-hex"
        },
        {
          "include": "#texture"
        },
        {
          "include": "#link"
        }
      ]
    },
    "color-friendly": {
      "match": "(\\|cRXP_FRIENDLY_)(.*?)(\\|r|$)",
      "captures": {
        "1": {
          "name": "comment.block.colorcode.rxp"
        },
        "2": {
          "name": "variable.other.constant.friendly.rxp"
        },
        "3": {
          "name": "comment.block.colorcode.rxp"
        }
      }
    },
    "color-enemy": {
      "match": "(\\|cRXP_ENEMY_)(.*?)(\\|r|$)",
      "captures": {
        "1": {
          "name": "comment.block.colorcode.rxp"
        },
        "2": {
          "name": "string.regexp.enemy.rxp"
        },
        "3": {
          "name": "comment.block.colorcode.rxp"
        }
      }
    },
    "color-warn": {
      "match": "(\\|cRXP_WARN_)(.*?)(\\|r|$)",
      "captures": {
        "1": {
          "name": "comment.block.colorcode.rxp"
        },
        "2": {
          "name": "constant.character.escape.warn.rxp"
        },
        "3": {
          "name": "comment.block.colorcode.rxp"
        }
      }
    },
    "color-loot": {
      "match": "(\\|cRXP_LOOT_)(.*?)(\\|r|$)",
      "captures": {
        "1": {
          "name": "comment.block.colorcode.rxp"
        },
        "2": {
          "name": "entity.name.tag.loot.rxp"
        },
        "3": {
          "name": "comment.block.colorcode.rxp"
        }
      }
    },
    "color-buy": {
      "match": "(\\|cRXP_BUY_)(.*?)(\\|r|$)",
      "captures": {
        "1": {
          "name": "comment.block.colorcode.rxp"
        },
        "2": {
          "name": "constant.numeric.buy.rxp"
        },
        "3": {
          "name": "comment.block.colorcode.rxp"
        }
      }
    },
    "color-pick": {
      "match": "(\\|cRXP_PICK_)(.*?)(\\|r|$)",
      "captures": {
        "1": {
          "name": "comment.block.colorcode.rxp"
        },
        "2": {
          "name": "keyword.control.pick.rxp"
        },
        "3": {
          "name": "comment.block.colorcode.rxp"
        }
      }
    },
    "color-other-rxp": {
      "match": "(\\|cRXP_[A-Z]+_)(.*?)(\\|r|$)",
      "captures": {
        "1": {
          "name": "comment.block.colorcode.rxp"
        },
        "2": {
          "name": "markup.italic.rxp"
        },
        "3": {
          "name": "comment.block.colorcode.rxp"
        }
      }
    },
    "color-hex": {
      "match": "(\\|c[0-9A-Fa-f]{8})(.*?)(\\|r|$)",
      "captures": {
        "1": {
          "name": "comment.block.colorcode.rxp"
        },
        "2": {
          "name": "constant.other.color.rxp"
        },
        "3": {
          "name": "comment.block.colorcode.rxp"
        }
      }
    },
    "texture": {
      "match": "\\|T[^|]*\\|t",
      "name": "comment.block.texture.rxp"
    },
    "link": {
      "match": "\\[[^\\]\\r\\n]+\\]",
      "name": "string.quoted.link.rxp"
    }
  }
}
